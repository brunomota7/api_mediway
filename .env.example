# Copie este arquivo para ".env" (ou exporte as variáveis no seu shell/CI)
# e preencha com valores reais. NUNCA versione o ".env" real.

# ===== Database =====
DB_URL=jdbc:mysql://localhost:3306/db_Mediway
DB_USERNAME=admin
DB_PASSWORD=change-me

# ===== RabbitMQ =====
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ===== SMTP (obrigatório - sem valor padrão) =====
# Gere uma senha de app dedicada em https://myaccount.google.com/apppasswords
# Nunca use a senha da sua conta Google diretamente aqui.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app
